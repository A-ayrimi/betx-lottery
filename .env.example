# ───────── Database (Supabase → Project Settings → Database → Connection string)
# Use the *Transaction pooler* URI (port 6543) on Vercel. Do NOT add ?sslmode=…
DATABASE_URL=postgresql://postgres.xxxxxxxx:YOUR_PASSWORD@aws-0-eu-central-1.pooler.supabase.com:6543/postgres
DATABASE_SSL=true

# ───────── App
# demo = simulated balances + sample activity | live = real payments, no fake data
# demo requires a local database (see src/lib/dbSafety.ts); with a remote DB keep live mode.
# This is a local template, not a production rollout manifest. Keep maintenance ON for local builds.
# Live mode is not approved and does not enable payments.
# Payments are hardcoded false in publicConfig().paymentsEnabled; never enable them here.
BETX_MODE=demo
MAINTENANCE_MODE=true
NEXT_PUBLIC_MAINTENANCE_MODE=true
APP_URL=https://your-project.vercel.app
VAULT_INITIAL=20
# long random string (≥16 chars) — protects /admin and /api/telegram/setup
ADMIN_TOKEN=change-me-to-a-long-random-string
# optional: separate long random string for read-only /admin and reporting access
ADMIN_VIEWER_TOKEN=
# ≥32 random chars — signs login sessions (generate: openssl rand -hex 32). REQUIRED in production.
SESSION_SECRET=

# ───────── Telegram bot
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=BetxLuckyBot
# random string, letters/digits/_/- only
TELEGRAM_WEBHOOK_SECRET=change-me-webhook-secret
# optional: your own chat id, receives withdrawal alerts
TELEGRAM_ADMIN_CHAT_ID=

# ───────── International / compliance
# Comma-separated ISO-3166 alpha-2 codes. MUST match your licence + sanctions law.
# Default (if unset): US,GB,FR,NL,AU,KP,IR,CU,SY
BLOCKED_COUNTRIES=US,GB,FR,NL,AU,KP,IR,CU,SY
# on | off — default: on when BETX_MODE=live
GEO_BLOCK=
COMPANY_NAME=BETX Ltd.
LICENSE_INFO=Licensed by … under licence no. …
SUPPORT_EMAIL=support@yourdomain.com
GAMBLING_HELP_URL=https://www.begambleaware.org

# ───────── Sign-in & deposit methods
# SOLANA-ONLY mode: USDC deposits and payouts use SPL-USDC on Solana.
SOLANA_ONLY=on
SOLANA_CLUSTER=mainnet-beta
SOLANA_TREASURY_ADDRESS=
SOLANA_USDC_MINT=EPjFWdd5AufqSSqeM2qN1xzybapC8G4wEGGkZwyTDt1v
SOLANA_TOKEN_DECIMALS=6
SOLANA_TOKEN_SYMBOL=USDC
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
SOLANA_MIN_DEPOSIT_USD=1

# ───────── Autopilot (automation engine)
# ≥16 random chars; protects /api/cron (Vercel Cron sends it automatically as Bearer)
CRON_SECRET=
# Rounds that don't fill in time are closed and refunded automatically (0 = never)
ROUND_TIMEOUT_HOURS=24

# ───────── Automatic withdrawals from a HOT wallet (off by default)
# Keep only a small float in this wallet; top it up from cold storage.
AUTO_PAYOUT=off
# SOLANA_PAYOUT_PRIVATE_KEY=<base58 or JSON secret key of the hot wallet — ONLY if AUTO_PAYOUT=on; keep off in Phase 1>
SOLANA_PAYOUT_PRIVATE_KEY=
AUTO_PAYOUT_MAX=50
AUTO_PAYOUT_DAILY_MAX=300
AUTO_PAYOUT_MAX_PER_USER_DAY=3
AUTO_PAYOUT_MIN_ACCOUNT_AGE_HOURS=1
AUTO_PAYOUT_MIN_PLAY_RATIO=0.3

# ───────── Treasury: automatic $5 fee per drawn round
# Main admin wallet — every round fee is auto-allocated here at draw time.
# Should match SOLANA_TREASURY_ADDRESS (Solana pubkey). Empty = not configured.
ADMIN_WALLET=
# Auto on-chain sweep of accrued fees from the hot wallet (off by default).
# When off, fees stay `accrued` (fully accounted + visible in /admin) until
# you transfer manually and record the tx hash.
AUTO_FEE_PAYOUT=off
FEE_SWEEP_THRESHOLD=20
FEE_SWEEP_MAX=500
